<Window x:Class="MoneyTracker.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账户" Height="700" Width="1120"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶部：总览 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeader" Style="{StaticResource H1}" Text="账户"/>
                    <TextBlock x:Name="txtSub" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="按分组摆开，组里再按类型归拢。点左边任意一个账户就能改它。"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="我的资产" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="txtOwnAssets" Style="{StaticResource Money}" FontSize="17" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="他人账户" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="txtOtherAssets" Style="{StaticResource Money}" FontSize="17"
                                   Foreground="{DynamicResource SubBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="垫付未还" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="txtDebtTotal" Style="{StaticResource Money}" FontSize="17"
                                   Foreground="{DynamicResource ExpenseBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="统计口径" Style="{StaticResource Muted}"/>
                        <ComboBox x:Name="cmbPeriod" Width="116" Margin="0,2,0,0"
                                  SelectionChanged="Period_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体：分组树 / 编辑 / 欠款 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="322"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="286"/>
            </Grid.ColumnDefinitions>

            <!-- 分组 → 类型 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="账户分组" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Button x:Name="btnAdd" Style="{StaticResource Btn}" Content="新增账户" Padding="14,7"
                                HorizontalAlignment="Right" Click="Add_Click"/>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="listGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8"
                                                Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <!-- 组头：组名 + 这组的支出 / 收入 / 余额 -->
                                                <!-- 这个 Grid 必须写成星号列 + 自动列。只写 <Grid> 不带列定义时
                                                     是单列 Auto，左边组名和右边金额会被塞进同一格，
                                                     宽度不够就互相重叠（之前「自己」和「支出 ¥1,344.00」
                                                     叠在一起看不清就是这个原因）。 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="14" VerticalAlignment="Center"/>
                                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush2}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding OthersVis}">
                                                            <TextBlock Text="他人" FontSize="11"
                                                                       Foreground="{DynamicResource SubBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding CountText}"
                                                                   Style="{StaticResource Muted}" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="支出" Style="{StaticResource Muted}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding OutText}"
                                                                   FontFamily="{StaticResource NumFont}" FontSize="12"
                                                                   Foreground="{DynamicResource ExpenseBrush}"
                                                                   Margin="5,0,12,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="收入" Style="{StaticResource Muted}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding InText}"
                                                                   FontFamily="{StaticResource NumFont}" FontSize="12"
                                                                   Foreground="{DynamicResource IncomeBrush}"
                                                                   Margin="5,0,12,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="余额" Style="{StaticResource Muted}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding BalanceText}"
                                                                   FontFamily="{StaticResource NumFont}" FontSize="12"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding OwnerText}" Style="{StaticResource Muted}"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding OwnerVis}"/>

                                                <!-- 组里按类型分层 -->
                                                <ItemsControl ItemsSource="{Binding Kinds}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,8">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="3" Height="12" CornerRadius="2"
                                                                            Background="{DynamicResource BorderBrush2}"
                                                                            VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Label}"
                                                                               Style="{StaticResource Muted}"
                                                                               Margin="8,0,0,0"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding SumText}"
                                                                               Style="{StaticResource Muted}"
                                                                               Margin="10,0,0,0"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <ItemsControl ItemsSource="{Binding Items}"
                                                                              Margin="0,4,0,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{Binding ChipStyle}"
                                                                                    Tag="{Binding}" Click="Chip_Click"
                                                                                    ToolTip="{Binding Tip}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding BadgeText}"
                                                                                               FontSize="11" Opacity="0.7"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="0,0,6,0"/>
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding BalanceText}"
                                                                                               FontFamily="{StaticResource NumFont}"
                                                                                               FontSize="12" Opacity="0.7"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="9,0,0,0"/>
                                                                                    <TextBlock Text="{Binding OutText}"
                                                                                               FontFamily="{StaticResource NumFont}"
                                                                                               FontSize="12" Opacity="0.7"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="5,0,0,0"
                                                                                               Visibility="{Binding OutVis}"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding NoteVis}"/>
                                                <Button Style="{StaticResource Chip}" FontSize="12"
                                                        Content="＋ 在这个组里加一个账户" Tag="{Binding}"
                                                        Click="AddToGroup_Click" Visibility="{Binding AddVis}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="txtEmptyTree" Style="{StaticResource Muted}" Visibility="Collapsed"
                                       Margin="2,6,0,0" TextWrapping="Wrap"
                                       Text="一个账户都没有。点右上角「新增账户」，或者先去设置里把账户建起来。"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 账户编辑 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="lblForm" Style="{StaticResource H2}" Text="修改账户" Margin="0,0,0,12"/>

                        <TextBlock Text="账户名" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtName" Margin="0,0,0,12"/>

                        <TextBlock Text="分组（自己的 / 家人的 / 他人的…名字随便起）"
                                   Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtGroup" TextChanged="Group_TextChanged"/>
                        <WrapPanel x:Name="panelGroups" Margin="0,2,0,10"/>

                        <TextBlock Text="归属人（这个账户是谁的，可以不填）"
                                   Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtOwner" Margin="0,0,0,10"/>

                        <CheckBox x:Name="chkOthers" Content="这是别人的账户" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="勾上就单独算：它不计入「我的资产」，支出收入也只算在这个组里。"/>

                        <TextBlock Text="类型" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbKind" Margin="0,0,0,4">
                            <ComboBoxItem Content="现金"/>
                            <ComboBoxItem Content="电子钱包（微信、支付宝）"/>
                            <ComboBoxItem Content="银行卡（储蓄卡）"/>
                            <ComboBoxItem Content="信用卡 / 借贷"/>
                            <ComboBoxItem Content="投资账户"/>
                            <ComboBoxItem Content="其他"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                                   Text="同一组的账户会按这个类型分层摆在一起。"/>

                        <TextBlock Text="初始余额（元）" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtInitial" FontFamily="{StaticResource NumFont}"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"
                                   Text="填「开始记账那一刻」这个账户里有多少钱。填 0 也行，之后每一笔会自动加减。"/>

                        <CheckBox x:Name="chkAssets" Content="计入净资产" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="信用卡这类欠着的账户如果不想算进净资产，就把这里取消掉。"/>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>

                        <Button x:Name="btnSave" Style="{StaticResource BtnPrimary}" Content="保存"
                                Padding="18,9" HorizontalAlignment="Stretch" Click="Ok_Click"/>
                        <Grid Margin="0,8,0,0">
                            <Button x:Name="btnDelete" Style="{StaticResource BtnDanger}" Content="删除账户"
                                    Padding="14,8" HorizontalAlignment="Left" Click="Delete_Click"/>
                            <Button Style="{StaticResource Btn}" Content="关闭" Padding="18,8"
                                    HorizontalAlignment="Right" Click="Close_Click"/>
                        </Grid>
                        <TextBlock x:Name="txtTip" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 替谁花了多少 / 谁欠我多少：合成一张卡 -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="替谁花了多少 · 谁欠我多少" Style="{StaticResource H2}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="下面每个人一行：一共替他花了多少、还欠多少。还欠只算标了「垫付」、还没还的支出（累计口径，不跟上面的月份走）。对方还了就点「已还清」，这里立刻少掉。"/>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="还欠合计" Style="{StaticResource Muted}" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="txtDebtSum" Style="{StaticResource Money}" FontSize="22"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ExpenseBrush}"/>
                        </Grid>
                        <TextBlock x:Name="txtSpentSum" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="listDebts">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8"
                                                Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Person}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UnpaidText}"
                                                               FontFamily="{StaticResource NumFont}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ExpenseBrush}"
                                                               Visibility="{Binding ZeroVis}"/>
                                                    <TextBlock Text="{Binding AmountText}"
                                                               FontFamily="{StaticResource NumFont}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ExpenseBrush}"
                                                               Visibility="{Binding DebtVis}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding SpentText}" Style="{StaticResource Muted}"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <Grid Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding DetailText}"
                                                               Style="{StaticResource Muted}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource Btn}" Content="已还清"
                                                            Padding="10,4" FontSize="12" HorizontalAlignment="Right"
                                                            Tag="{Binding}" Click="Settle_Click"
                                                            Visibility="{Binding SettleVis}"
                                                            ToolTip="他这笔钱还我了：这些垫付从欠款里扣掉"/>
                                                    <Button Style="{StaticResource Btn}" Content="撤销已还"
                                                            Padding="10,4" FontSize="12" HorizontalAlignment="Right"
                                                            Tag="{Binding}" Click="Unsettle_Click"
                                                            Visibility="{Binding UndoVis}"
                                                            ToolTip="点错了：把这些垫付重新算成没还"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="txtNoDebt" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Margin="2,4,0,0"
                                       Text="还没人欠我钱。记账时把「垫付」勾上、写上替谁花的，这里就会自己攒起来。"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>