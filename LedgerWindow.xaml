<Window x:Class="MoneyTracker.LedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账本管理" Height="580" Width="700"
        MinHeight="500" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 标题 ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="账本" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="一人一本账，各记各的。侧边栏里高亮的那个，就是现在正在看的账本。"/>
            </StackPanel>
            <Button Content="＋ 新建账本" Style="{StaticResource Btn}" Padding="14,8"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="New_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 左：账本列表 ==================== -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}" Padding="6,4,6,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="全部账本" Style="{StaticResource Muted}" Margin="6,4,0,6"/>
                    <ListBox Grid.Row="1" x:Name="listLedgers" Background="Transparent"
                             ItemContainerStyle="{StaticResource RowItem}"
                             SelectionChanged="Ledger_Selected"/>
                </Grid>
            </Border>

            <!-- ==================== 右：编辑区 ==================== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="txtFormTitle" Text="账本信息" Style="{StaticResource H2}" Margin="0,0,0,12"/>

                    <TextBlock Text="名称" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtName"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,14" FontSize="11" TextWrapping="Wrap"
                               Text="比如「我」「老婆」「小店」。"/>

                    <TextBlock Text="标识色" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="panelColors" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtColor"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,14" FontSize="11" TextWrapping="Wrap"
                               Text="点个色块，或者自己填 #RRGGBB。留空就是按顺序自动配色。"/>

                    <TextBlock Text="备注" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNote"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,10" FontSize="11" TextWrapping="Wrap"
                               Text="随便写点：这把账是干嘛的、谁的。"/>

                    <CheckBox x:Name="chkArchived" Content="归档（收起来，不在侧边栏显示）"/>

                    <Border Style="{StaticResource Divider}"/>

                    <TextBlock Text="删除这个账本" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtDeleteHint" Style="{StaticResource Muted}" TextWrapping="Wrap"/>

                    <TextBlock Text="删除时，把它的记录转到" Style="{StaticResource Muted}" Margin="0,12,0,5"/>
                    <ComboBox x:Name="cmbMoveTo" DisplayMemberPath="name"/>
                    <CheckBox x:Name="chkAlsoRecords" Content="连记录一起删掉（危险，会真的少掉记录）"
                              Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 底部按钮 ==================== -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="btnUse" Content="切到这个账本" Style="{StaticResource Btn}" Padding="14,9"
                        Click="Use_Click"/>
                <TextBlock x:Name="txtTip" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="12,0,0,0" MaxWidth="240" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" Style="{StaticResource Btn}" Padding="20,9" Click="Close_Click"/>
                <Button x:Name="btnDelete" Content="删除账本" Style="{StaticResource BtnDanger}" Padding="18,9"
                        Margin="10,0,0,0" Click="Delete_Click"/>
                <Button x:Name="btnSave" Content="保存" Style="{StaticResource BtnPrimary}" Padding="24,9"
                        Margin="10,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>