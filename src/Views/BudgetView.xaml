<UserControl x:Class="MoneyTracker.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}" Background="{DynamicResource BgSoftBrush}">
    <Grid Margin="22,16,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="预算月份" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbMonth" Width="140" SelectionChanged="Month_Changed"/>
                    </StackPanel>
                    <StackPanel Margin="0,20,0,0">
                        <Button Style="{StaticResource Btn}" Content="上个月" Click="Prev_Click"/>
                    </StackPanel>
                    <StackPanel Margin="8,20,0,0">
                        <Button Style="{StaticResource Btn}" Content="下个月" Click="Next_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BtnPrimary}" Content="新增一项预算" Padding="16,8"
                            Click="Add_Click"/>
                    <Button Style="{StaticResource Btn}" Content="给所有分类按上月均摊" Padding="16,8"
                            Margin="8,0,0,0" Click="AutoFill_Click" ToolTip="按近 3 个月的平均支出自动生成各项预算"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 总预算 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock x:Name="txtTotalTitle" Text="本月总预算" Style="{StaticResource H2}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="txtTotalUsed" Style="{StaticResource Money}" FontSize="30"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtTotalOf" Style="{StaticResource Muted}" FontSize="14"
                                           VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                            </StackPanel>
                            <Border x:Name="barTotal" Height="14" CornerRadius="7" Margin="0,12,0,0"
                                    Background="{DynamicResource Surface2Brush}" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="colTotalFill" Width="0*"/>
                                        <ColumnDefinition x:Name="colTotalRest" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="barTotalFill" Grid.Column="0" CornerRadius="7"
                                            Background="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="txtTotalHint" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="150">
                            <TextBlock Text="剩余可用" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="txtTotalLeft" Style="{StaticResource Money}" FontSize="22"
                                       FontWeight="SemiBold" Margin="0,4,0,12"/>
                            <TextBlock Text="还剩几天" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="txtDaysLeft" Style="{StaticResource Money}" FontSize="16"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 分类预算 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="各项预算" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="txtCount" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="listBudgets"/>
                        <TextBlock x:Name="txtEmpty" Style="{StaticResource Muted}"
                                   Text="还没有设置分类预算。点右上角「新增一项预算」，或者用「按上月均摊」自动生成一套。"
                                   Margin="0,10,0,4" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 超支提醒 -->
                <Border x:Name="boxAlert" Style="{StaticResource Card}" Margin="0,12,0,0"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="需要注意的地方" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="listAlerts"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>