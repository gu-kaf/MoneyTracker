<Window x:Class="MoneyTracker.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改这一笔" Height="640" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtHeader" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="类型" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbType" SelectionChanged="Type_Changed">
                        <ComboBoxItem Content="支出" Tag="expense"/>
                        <ComboBoxItem Content="收入" Tag="income"/>
                        <ComboBoxItem Content="转账" Tag="transfer"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="金额（元）" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtAmount" FontFamily="{StaticResource NumFont}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="日期" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDate" Style="{StaticResource DateInput}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="时间" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTime" Style="{StaticResource DateInput}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="分类" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbCat" SelectionChanged="Cat_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="子分类（可以不选）" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbSub" SelectionChanged="Sub_Changed"
                              ToolTip="下拉里挑一个，或者直接在下面写"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtSub" Grid.Column="0" MaxLength="12"
                                 ToolTip="自己写也行，留空就是不细分"
                                 TextChanged="SubText_Changed"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Content="清空"
                                Padding="10,7" Margin="6,0,0,0" Click="ClearSub_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock x:Name="lblAcc" Text="账户" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbAcc"/>
                </StackPanel>

                <StackPanel x:Name="boxTo" Grid.Row="3" Grid.Column="2" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock Text="转入账户" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbTo"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="商户 / 对方" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtMerchant"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="标签（逗号分隔）" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTags"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="备注" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNote"/>
                </StackPanel>

                <CheckBox x:Name="chkExclude" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="不计入预算统计"/>

                <!-- ============ 替别人付的钱 ============
                     都是可选项：留空就是自己的事，不填照样能保存。 -->
                <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,12">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10"/>
                    <TextBlock Text="替谁花的（可以不填）" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtForWhom" TextChanged="ForWhom_Changed"
                             ToolTip="留空就是自己的事。写个名字，下次记账能直接点选"/>
                    <WrapPanel x:Name="panelForWhom" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
                    <CheckBox x:Name="chkAdvance" Content="垫付：这笔钱对方该还我"
                              Checked="Advance_Changed" Unchecked="Advance_Changed"/>
                    <CheckBox x:Name="chkReimbursed" Content="对方已经还了" Margin="22,6,0,0"
                              ToolTip="勾上就从「谁欠我多少」里扣掉"/>
                    <TextBlock x:Name="txtAdvanceHint" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="btnDelete" Style="{StaticResource BtnDanger}" Content="删除这一笔"
                        Click="Delete_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" Content="取消" Padding="20,9" Click="Cancel_Click"/>
                <Button x:Name="btnOk" Style="{StaticResource BtnPrimary}" Content="保存" Padding="24,9"
                        Margin="10,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>