<UserControl x:Class="MoneyTracker.RecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}"
             Background="{DynamicResource BgSoftBrush}">
    <Grid Margin="22,16,22,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="392"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左：金额 + 键盘 ==================== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>

                <!-- 类型切换 -->
                <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="3" Margin="0,0,0,14">
                    <Button x:Name="tabExpense" Style="{StaticResource Btn}" Content="支出"
                            Margin="0,0,6,0" Click="Type_Click" Tag="expense"/>
                    <Button x:Name="tabIncome" Style="{StaticResource Btn}" Content="收入"
                            Margin="3,0,3,0" Click="Type_Click" Tag="income"/>
                    <Button x:Name="tabTransfer" Style="{StaticResource Btn}" Content="转账"
                            Margin="6,0,0,0" Click="Type_Click" Tag="transfer"/>
                </UniformGrid>

                <!-- 金额大字 -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
                        CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="txtAmountHint" Text="金额" Style="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="¥" FontSize="22" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource SubBrush}" Margin="0,0,4,5"/>
                            <!-- 金额用等宽数字字体，不要用中文字体：中文字体没有粗体字重，
                                 34 号下的 SemiBold 是算法撑出来的假粗，边缘会发毛。
                                 NumFont 是等宽数字面，有真 Bold，加粗是真的，数字也对得齐。 -->
                            <TextBlock x:Name="txtAmount" Text="0.00"
                                       FontFamily="{DynamicResource NumFont}" FontSize="34"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ExpenseBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 数字键盘 -->
                <UniformGrid DockPanel.Dock="Bottom" Rows="4" Columns="4" Height="232"
                             VerticalAlignment="Bottom">
                    <Button Style="{StaticResource Keypad}" Content="1" Click="Key_Click" Tag="1"/>
                    <Button Style="{StaticResource Keypad}" Content="2" Click="Key_Click" Tag="2"/>
                    <Button Style="{StaticResource Keypad}" Content="3" Click="Key_Click" Tag="3"/>
                    <Button Style="{StaticResource Keypad}" Content="⌫" Click="Key_Click" Tag="back"/>

                    <Button Style="{StaticResource Keypad}" Content="4" Click="Key_Click" Tag="4"/>
                    <Button Style="{StaticResource Keypad}" Content="5" Click="Key_Click" Tag="5"/>
                    <Button Style="{StaticResource Keypad}" Content="6" Click="Key_Click" Tag="6"/>
                    <Button Style="{StaticResource Keypad}" Content="清空" FontSize="14" Click="Key_Click" Tag="clear"/>

                    <Button Style="{StaticResource Keypad}" Content="7" Click="Key_Click" Tag="7"/>
                    <Button Style="{StaticResource Keypad}" Content="8" Click="Key_Click" Tag="8"/>
                    <Button Style="{StaticResource Keypad}" Content="9" Click="Key_Click" Tag="9"/>
                    <Button Style="{StaticResource Keypad}" Content="+10" FontSize="14" Click="Key_Click" Tag="+10"/>

                    <Button Style="{StaticResource Keypad}" Content="." Click="Key_Click" Tag="."/>
                    <Button Style="{StaticResource Keypad}" Content="0" Click="Key_Click" Tag="0"/>
                    <Button Style="{StaticResource Keypad}" Content="00" Click="Key_Click" Tag="00"/>
                    <Button Style="{StaticResource Keypad}" Content="+50" FontSize="14" Click="Key_Click" Tag="+50"/>
                </UniformGrid>
            </DockPanel>
        </Border>

        <!-- ==================== 右：分类 + 字段 + 保存 ==================== -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock x:Name="txtCatHint" Text="选择分类" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <WrapPanel x:Name="panelCat" Margin="0,0,0,6"/>

                    <!-- 二级分类：选了一级分类才展开。规则很直白——不选也能记账，选了只是更好看报表 -->
                    <StackPanel x:Name="boxSub" Margin="0,10,0,0">
                        <TextBlock x:Name="txtSubHint" Text="二级分类（可以不选）" Style="{StaticResource Muted}"/>

                        <StackPanel x:Name="boxSubEmpty" Margin="0,6,0,0">
                            <TextBlock x:Name="txtSubEmpty" Text="先点上面一个一级分类" Style="{StaticResource Muted}"/>
                        </StackPanel>

                        <StackPanel x:Name="boxSubPick" Visibility="Collapsed">
                            <TextBlock Text="常用" Style="{StaticResource Muted}" FontSize="12"
                                       Margin="0,9,0,6"/>
                            <WrapPanel x:Name="panelSubFreq"/>

                            <TextBlock x:Name="txtSubAllHint" Text="全部" Style="{StaticResource Muted}"
                                       FontSize="12" Margin="0,2,0,6"/>
                            <WrapPanel x:Name="panelSub"/>

                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtSub" Grid.Column="0" MaxLength="12"
                                         ToolTip="想写什么写什么，比如「咖啡」「看病挂号」"
                                         TextChanged="SubText_Changed"/>
                                <TextBlock x:Name="txtSubPlaceholder" Grid.Column="0"
                                           Text="也可以自己写一个，或留空" Style="{StaticResource Muted}"
                                           Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="btnSubClear" Grid.Column="1" Style="{StaticResource Btn}"
                                        Content="清空" Padding="12,7" Margin="8,0,0,0"
                                        Click="ClearSub_Click"/>
                            </Grid>
                            <TextBlock x:Name="txtSubTip" Style="{StaticResource Muted}" FontSize="12"
                                       Text="再点一下选中的按钮可以取消" Margin="0,7,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" Margin="0,14,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock x:Name="lblAccount" Text="账户" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbAccount"/>
                        </StackPanel>

                        <StackPanel x:Name="boxToAccount" Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"
                                    Visibility="Collapsed">
                            <TextBlock Text="转入账户" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbToAccount"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="日期" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtDate" Grid.Column="0" Style="{StaticResource DateInput}"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="今天"
                                        Padding="10,7" Margin="6,0,0,0" Click="Today_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource Btn}" Content="昨天"
                                        Padding="10,7" Margin="4,0,0,0" Click="Yesterday_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="时间" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtTime" Style="{StaticResource DateInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="商户 / 对方" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtMerchant" TextChanged="Merchant_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="标签（逗号分隔）" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtTags"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="备注" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtNote" AcceptsReturn="False"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="chkExcludeBudget" Content="不计入预算（报销、还款等）"
                              Margin="0,12,0,0"/>

                    <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>

                    <!-- ============ 替别人付的钱 ============
                         不填就是自己的事，填了账户页就能按名字算出「谁欠我多少」。
                         这两项都是可选的，空着照样能保存，绝不会拦住记账。 -->
                    <TextBlock Text="替谁花的（可以不填）" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtForWhom" TextChanged="ForWhom_Changed"
                             ToolTip="留空就是自己的事。写个名字，下次在这里点按钮就能直接选"/>
                    <WrapPanel x:Name="panelForWhom" Margin="0,6,0,0"/>
                    <CheckBox x:Name="chkAdvance" Content="垫付：这笔钱对方该还我" Margin="0,10,0,4"/>
                    <TextBlock x:Name="txtAdvanceHint" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="勾上之后，账户页的「谁欠我多少」会按名字攒起来。不填不影响记账。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="btnSave" Style="{StaticResource BtnPrimary}" Content="记下这笔"
                                Padding="26,10" FontSize="14" Click="Save_Click"/>
                        <Button x:Name="btnSaveMore" Style="{StaticResource Btn}" Content="保存并再来一笔"
                                Padding="18,10" Margin="10,0,0,0" Click="SaveMore_Click"/>
                        <TextBlock x:Name="txtTip" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" Text="可以直接敲数字 → 选分类 → 保存"/>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" Margin="0,18,0,12"/>

                    <TextBlock Text="最近 5 笔（点一下复用它的分类和账户）" Style="{StaticResource Muted}"
                               Margin="0,0,0,8"/>
                    <ItemsControl x:Name="listRecent"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>